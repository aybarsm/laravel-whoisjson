{
    "name": "aybarsm/laravel-whoisjson",
    "version": "dev-main",
    "description": "An opinionated Laravel service provider package for whoisjson.com wrapper",
    "type": "library",
    "license": "MIT",
    "keywords": ["aybarsm", "php", "laravel", "whois", "whoisjson", "dns", "ssl", "domain-availability", "subdomains", "rdap"],
    "homepage": "https://www.github.com/aybarsm/laravel-whoisjson",
    "support": {
        "email": "dev@blrm.net"
    },
    "authors": [
        {
            "name": "Murat Aybars",
            "email": "murat.aybars@blrm.net",
            "homepage": "https://www.blrm.net",
            "role": "Founder"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Aybarsm\\Laravel\\WhoisJson\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aybarsm\\Laravel\\WhoisJson\\WhoisJsonServiceProvider"
            ],
            "aliases": {
                "WhoisJson": "Aybarsm\\Laravel\\WhoisJson\\Facades\\WhoisJson"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
